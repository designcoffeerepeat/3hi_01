---
const live = Boolean(import.meta.env.PUBLIC_SCAN_ENDPOINT);
---

<section class="scan" id="scan" aria-labelledby="scan-title" data-live={live ? 'true' : 'false'}>
  <div class="scan__inner wrap">
    <div class="scan__copy">
      <p class="eyebrow" data-reveal>
        Free AI visibility scan
      </p>
      <h2 class="scan__title" id="scan-title" data-reveal>
        Does <em class="serif">AI</em> recommend you?
      </h2>
      <p class="scan__lede" data-reveal style="--d:1">
        When someone asks ChatGPT, Claude, Gemini or Perplexity who to hire or where to buy, does
        your name come up? Enter your website and see how ready it is to be found, understood and
        recommended.
      </p>

      <form class="scan__form" data-scan-form novalidate data-reveal style="--d:2">
        <label class="sr-only" for="scan-url">
          Your website address
        </label>
        <div class="scan__field">
          <span class="scan__prefix mono" aria-hidden="true">
            https://
          </span>
          <input
            id="scan-url"
            name="url"
            type="text"
            inputmode="url"
            autocomplete="url"
            autocapitalize="off"
            spellcheck="false"
            placeholder="yourwebsite.com"
            required
            aria-describedby="scan-hint"
          />
          <button class="btn scan__btn" type="submit" data-scan-btn>
            <span class="scan__btn-label">Scan</span>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <circle
                cx="10.5"
                cy="10.5"
                r="6.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
              ></circle>
              <path
                d="M15.5 15.5 21 21"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
              ></path>
            </svg>
          </button>
        </div>
        <p class="scan__hint mono" id="scan-hint" data-scan-hint>
          {live ? 'Takes about a minute. No sign-up needed.' : 'Demo preview. No sign-up needed.'}
        </p>
      </form>
    </div>

    <div class="scan__stage" aria-hidden="true">
      <canvas class="scan__canvas" data-scan-canvas></canvas>
      <div class="scan__fallback"></div>
      <ol class="scan__steps mono" data-scan-steps>
        <li>Visiting your site</li>
        <li>Checking what AI crawlers can read</li>
        <li>Looking for structured data</li>
        <li>Testing answer-ready content</li>
        <li>Scoring</li>
      </ol>
    </div>
  </div>

  <div class="scan__result wrap" data-scan-result hidden aria-live="polite">
    <div class="result">
      <div class="result__head">
        <div class="result__dial" data-dial style="--v:0">
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <circle cx="60" cy="60" r="52" pathLength="100"></circle>
            <circle cx="60" cy="60" r="52" pathLength="100" class="result__arc"></circle>
          </svg>
          <span>
            <b data-score>0</b>
            <small>/100</small>
          </span>
        </div>
        <div>
          <p class="mono result__url" data-result-url></p>
          <p class="result__summary" data-summary></p>
          <p class="result__demo" data-demo-note>
            <strong>Demo result.</strong> This preview is generated in your browser from the address
            alone. It does not analyse your site. Book the free audit and our team runs the real
            check.
          </p>
        </div>
      </div>
      <ul class="result__checks" data-checks></ul>
      <div class="result__cta">
        <a href="#contact" class="btn btn--light" data-result-cta>
          Get my real AI audit
        </a>
        <button type="button" class="btn btn--ghost" data-scan-again>
          Scan another site
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .scan {
    position: relative;
    z-index: 2;
    margin-top: calc(var(--radius) * -1);
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--blue);
    color: var(--paper);
    padding-block: clamp(72px, 10vw, 150px) clamp(64px, 8vw, 120px);
    overflow: hidden;
  }
  .scan::before {
    /* soft glow behind the orb */
    content: '';
    position: absolute;
    right: -10%;
    top: 0;
    width: 70%;
    aspect-ratio: 1;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--pink) 45%, transparent),
      transparent
    );
    opacity: 0.55;
    pointer-events: none;
  }
  .scan__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
  }
  .scan__title {
    margin-block: 20px 28px;
    font-weight: 600;
    font-size: clamp(54px, 8.4vw, 168px);
    line-height: 0.86;
    letter-spacing: -0.06em;
  }
  .scan__title em {
    color: var(--pink);
    padding-right: 0.04em;
  }
  .scan__lede {
    max-width: 46ch;
    font-size: clamp(17px, 1.35vw, 21px);
    line-height: 1.45;
    opacity: 0.9;
  }

  .scan__form {
    margin-top: clamp(28px, 3.4vw, 48px);
    max-width: 720px;
  }
  .scan__field {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 8px 8px 24px;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    box-shadow:
      0 0 0 0 var(--pink),
      0 24px 60px -20px rgba(12, 12, 14, 0.5);
    transition: box-shadow 0.4s var(--ease);
  }
  .scan__field:focus-within {
    box-shadow:
      0 0 0 5px var(--pink),
      0 24px 60px -20px rgba(12, 12, 14, 0.5);
  }
  .scan__prefix {
    color: var(--muted);
    font-size: 14px;
    text-transform: none;
  }
  .scan__field input {
    flex: 1;
    min-width: 0;
    height: 56px;
    border: 0;
    background: none;
    font-size: clamp(18px, 1.6vw, 24px);
    font-weight: 500;
    letter-spacing: -0.02em;
    outline: none;
  }
  .scan__field input::placeholder {
    color: #a3a09a;
  }
  .scan__btn {
    min-height: 60px;
    padding-inline: 30px;
    font-size: 18px;
  }
  .scan__btn::after {
    background: var(--pink);
  }
  .scan__btn:hover {
    color: var(--ink);
  }
  .scan__btn[disabled] {
    cursor: progress;
  }
  .scan__btn[disabled] svg {
    animation: wobble 0.9s ease-in-out infinite;
  }
  .scan__hint {
    margin: 14px 0 0 24px;
    font-size: 12px;
    opacity: 0.75;
    min-height: 1.4em;
  }
  .scan__hint.is-error {
    opacity: 1;
    color: var(--pink);
  }

  .scan__stage {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
  }
  .scan__canvas {
    position: absolute;
    inset: -10%;
    width: 120%;
    height: 120%;
  }
  .scan__fallback {
    display: none;
  }
  html.no-webgl .scan__fallback {
    display: block;
    position: absolute;
    inset: 18%;
    border-radius: 50%;
    background: radial-gradient(
      circle at 35% 30%,
      var(--paper),
      var(--mauve) 55%,
      var(--blue-deep)
    );
  }
  .scan__steps {
    position: absolute;
    left: 0;
    bottom: -6%;
    display: grid;
    gap: 6px;
    font-size: 11px;
  }
  .scan__steps li {
    opacity: 0;
    transform: translateX(-10px);
    transition:
      opacity 0.4s,
      transform 0.5s var(--ease);
  }
  .scan__steps li::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 10px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    vertical-align: 1px;
  }
  .scan__steps li.is-on {
    opacity: 1;
    transform: none;
  }
  .scan__steps li.is-done::before {
    background: var(--pink);
    border-color: var(--pink);
  }

  /* ---------- result ---------- */
  .scan__result {
    position: relative;
    margin-top: clamp(40px, 5vw, 72px);
  }
  .result {
    padding: clamp(24px, 3.4vw, 52px);
    border-radius: var(--radius);
    background: var(--ink);
    animation: result-in 0.9s var(--ease) both;
  }
  .result__head {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: clamp(20px, 3vw, 48px);
  }
  .result__dial {
    position: relative;
    width: clamp(120px, 13vw, 180px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .result__dial svg {
    position: absolute;
    inset: 0;
    transform: rotate(-90deg);
  }
  .result__dial circle {
    fill: none;
    stroke: rgba(242, 240, 235, 0.14);
    stroke-width: 10;
  }
  .result__dial .result__arc {
    stroke: var(--pink);
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: calc(100 - var(--v));
    transition: stroke-dashoffset 1.4s var(--ease);
  }
  .result__dial b {
    font-size: clamp(40px, 4.6vw, 64px);
    letter-spacing: -0.05em;
  }
  .result__dial small {
    opacity: 0.6;
    margin-left: 2px;
  }
  .result__url {
    opacity: 0.6;
    font-size: 12px;
    word-break: break-all;
  }
  .result__summary {
    margin-block: 8px 14px;
    font-size: clamp(24px, 2.6vw, 40px);
    font-weight: 550;
    line-height: 1.08;
    letter-spacing: -0.035em;
    max-width: 24ch;
  }
  .result__demo {
    display: inline-block;
    max-width: 62ch;
    padding: 10px 14px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--pink) 18%, transparent);
    border: 1px dashed var(--pink);
    font-size: 14px;
    line-height: 1.45;
  }
  .result__checks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 12px;
    margin-block: clamp(24px, 3vw, 40px);
  }
  .result__checks :global(li) {
    padding: 18px 20px;
    border-radius: 18px;
    background: var(--ink-2);
    animation: result-in 0.7s var(--ease) both;
    animation-delay: calc(var(--i) * 70ms + 200ms);
  }
  .result__checks :global(.check__top) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-weight: 550;
  }
  .result__checks :global(.check__bar) {
    height: 6px;
    margin-block: 12px 10px;
    border-radius: 6px;
    background: rgba(242, 240, 235, 0.12);
    overflow: hidden;
  }
  .result__checks :global(.check__bar i) {
    display: block;
    height: 100%;
    width: calc(var(--v) * 1%);
    border-radius: inherit;
    background: var(--tone);
    transform-origin: left;
    animation: grow 1.2s var(--ease) both;
    animation-delay: calc(var(--i) * 70ms + 300ms);
  }
  .result__checks :global(.check__note) {
    font-size: 14px;
    opacity: 0.65;
    line-height: 1.4;
  }
  .result__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @keyframes result-in {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
  }
  @keyframes grow {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes wobble {
    50% {
      transform: rotate(-20deg) scale(1.15);
    }
  }

  @media (max-width: 900px) {
    .scan__inner {
      grid-template-columns: 1fr;
    }
    .scan__stage {
      order: -1;
      width: min(72vw, 360px);
      margin: -20px auto -30px;
    }
    .scan__steps {
      display: none;
    }
    .result__head {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .scan__field {
      flex-wrap: wrap;
      padding: 8px;
      border-radius: 28px;
    }
    .scan__prefix {
      display: none;
    }
    .scan__field input {
      padding-inline: 14px;
      flex-basis: 100%;
    }
    .scan__btn {
      flex: 1;
    }
  }
</style>

<script>
  import { hasWebGL } from '../scripts/webgl';
  import { normalizeUrl, runScan, demoResult, type ScanResult } from '../scripts/scan';
  import { scrollToEl } from '../scripts/motion';

  const root = document.getElementById('scan')!;
  const form = root.querySelector<HTMLFormElement>('[data-scan-form]')!;
  const input = form.querySelector<HTMLInputElement>('input')!;
  const btn = form.querySelector<HTMLButtonElement>('[data-scan-btn]')!;
  const hint = form.querySelector<HTMLElement>('[data-scan-hint]')!;
  const steps = [...root.querySelectorAll<HTMLLIElement>('[data-scan-steps] li')];
  const out = root.querySelector<HTMLElement>('[data-scan-result]')!;
  const defaultHint = hint.textContent;

  const canvas = root.querySelector<HTMLCanvasElement>('[data-scan-canvas]')!;
  if (hasWebGL()) {
    // Load the orb only when the section gets close to the viewport.
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        import('../scripts/three/scan-orb').then(({ mountScanOrb }) => mountScanOrb(canvas));
      },
      { rootMargin: '400px' }
    );
    io.observe(canvas);
  } else {
    document.documentElement.classList.add('no-webgl');
  }

  const emit = (phase: 'idle' | 'scanning' | 'done', score?: number) =>
    dispatchEvent(new CustomEvent('scan:state', { detail: { phase, score } }));

  const tones = ['var(--pink)', 'var(--mauve)', 'var(--paper)'];
  const toneFor = (v: number) => tones[v >= 70 ? 2 : v >= 45 ? 1 : 0];

  function render(r: ScanResult) {
    out.hidden = false;
    out.querySelector('[data-result-url]')!.textContent = r.url;
    out.querySelector('[data-summary]')!.textContent = r.summary;
    out.querySelector<HTMLElement>('[data-demo-note]')!.hidden = !r.demo;
    const dial = out.querySelector<HTMLElement>('[data-dial]')!;
    const scoreEl = out.querySelector<HTMLElement>('[data-score]')!;
    dial.style.setProperty('--v', '0');
    requestAnimationFrame(() =>
      requestAnimationFrame(() => dial.style.setProperty('--v', String(r.score)))
    );
    const t0 = performance.now();
    const count = (now: number) => {
      const k = Math.min((now - t0) / 1200, 1);
      scoreEl.textContent = String(Math.round(r.score * (1 - Math.pow(1 - k, 3))));
      if (k < 1) requestAnimationFrame(count);
    };
    requestAnimationFrame(count);

    const list = out.querySelector<HTMLElement>('[data-checks]')!;
    list.replaceChildren(
      ...r.checks.map((c, i) => {
        const li = document.createElement('li');
        li.style.setProperty('--i', String(i));
        li.innerHTML = `
          <div class="check__top"><span></span><span class="mono"></span></div>
          <div class="check__bar" style="--v:${c.score};--tone:${toneFor(c.score)}"><i></i></div>
          <p class="check__note"></p>`;
        li.querySelector('.check__top span')!.textContent = c.label;
        li.querySelector('.check__top .mono')!.textContent = `${c.score}/100`;
        li.querySelector('.check__note')!.textContent = c.note;
        return li;
      })
    );

    const cta = out.querySelector<HTMLAnchorElement>('[data-result-cta]')!;
    cta.dataset.website = r.url;
    scrollToEl(out);
  }

  function playSteps() {
    steps.forEach((s) => s.classList.remove('is-on', 'is-done'));
    const timers = steps.map((s, i) =>
      setTimeout(() => {
        s.classList.add('is-on');
        steps[i - 1]?.classList.add('is-done');
      }, i * 700)
    );
    return () => {
      timers.forEach(clearTimeout);
      steps.forEach((s) => s.classList.add('is-on', 'is-done'));
      setTimeout(() => steps.forEach((s) => s.classList.remove('is-on', 'is-done')), 1600);
    };
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const url = normalizeUrl(input.value);
    if (!url) {
      hint.textContent =
        'That does not look like a website address. Try something like yourbrand.com';
      hint.classList.add('is-error');
      input.focus();
      return;
    }
    hint.classList.remove('is-error');
    hint.textContent = `Scanning ${url.hostname}…`;
    btn.disabled = true;
    btn.querySelector('.scan__btn-label')!.textContent = 'Scanning';
    out.hidden = true;
    emit('scanning');
    const stop = playSteps();

    let result: ScanResult;
    try {
      result = await runScan(url);
    } catch {
      // A live endpoint failed: fall back to the clearly labelled demo.
      result = demoResult(url);
    }
    stop();
    emit('done', result.score);
    btn.disabled = false;
    btn.querySelector('.scan__btn-label')!.textContent = 'Scan';
    hint.textContent = defaultHint;
    render(result);
  });

  input.addEventListener('input', () => {
    hint.classList.remove('is-error');
    hint.textContent = defaultHint;
  });

  root.querySelector('[data-scan-again]')!.addEventListener('click', () => {
    out.hidden = true;
    emit('idle');
    input.select();
    scrollToEl(form, -200);
  });

  // Carry the scanned address into the contact form.
  root.querySelector<HTMLAnchorElement>('[data-result-cta]')!.addEventListener('click', (e) => {
    const site = (e.currentTarget as HTMLElement).dataset.website;
    if (site)
      dispatchEvent(
        new CustomEvent('contact:prefill', { detail: { website: site, topic: 'AI audit' } })
      );
  });
</script>
