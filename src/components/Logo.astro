---
// 3H-i logo: three horizons rising over a line, plus the wordmark.
// This is drawn in code as a stand-in. To use the official artwork,
// drop it in public/logo.svg and swap the <svg> below for an <img>.
interface Props {
  class?: string;
  mark?: boolean;
}
const { class: cls = '', mark = true } = Astro.props;
---

<span class:list={['logo', cls]}>
  {mark && (
    <svg class="logo__mark" viewBox="0 0 48 30" aria-hidden="true">
      <path d="M4 26a20 20 0 0 1 40 0" fill="none" stroke="currentColor" stroke-width="4" />
      <path d="M11 26a13 13 0 0 1 26 0" fill="none" stroke="var(--blue)" stroke-width="4" />
      <path d="M18 26a6 6 0 0 1 12 0z" fill="var(--pink)" />
      <rect x="0" y="26" width="48" height="3.2" rx="1.6" fill="currentColor" />
    </svg>
  )}
  <span class="logo__word">
    3H<span class="logo__dash">-</span>i
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .logo__mark {
    width: 1.6em;
    height: auto;
    overflow: visible;
  }
  .logo__dash {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    color: var(--blue);
    padding-inline: 0.02em;
  }
</style>
