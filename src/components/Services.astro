---
import Glyph from './Glyph.astro';
import { services } from '../data/site';
---

<section class="services" id="services" aria-labelledby="services-title">
  <header class="services__head wrap">
    <p class="eyebrow" data-reveal>
      Services
    </p>
    <h2 class="title" id="services-title" data-reveal>
      Five ways <em class="serif">up.</em>
    </h2>
    <p class="services__intro" data-reveal style="--d:1">
      One team connecting AI, design, search, social and growth, so every channel pushes in the same
      direction.
    </p>
  </header>

  <ol class="stack wrap">
    {services.map((s, i) => (
      <li class={`card card--${s.tone}`} style={`--i:${i}`}>
        <div class="card__text">
          <span class="card__num mono">({s.num})</span>
          <h3 class="card__name">{s.name}</h3>
          <p class="card__blurb">{s.blurb}</p>
          <ul class="card__tags mono">
            {s.tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </div>
        <div class="card__art">
          <Glyph name={s.glyph as any} />
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .services {
    padding-block: clamp(80px, 10vw, 160px) clamp(40px, 6vw, 100px);
    background: var(--paper);
  }
  .services__head {
    display: grid;
    grid-template-columns: 1fr minmax(0, 32ch);
    align-items: end;
    gap: 16px 40px;
    margin-bottom: clamp(40px, 6vw, 90px);
  }
  .services__head .eyebrow {
    grid-column: 1 / -1;
  }
  .services__intro {
    font-size: clamp(17px, 1.3vw, 20px);
    line-height: 1.45;
    color: var(--muted);
  }

  .stack {
    display: grid;
    gap: clamp(16px, 2vw, 28px);
  }
  .card {
    --g1: var(--ink);
    --g2: var(--paper);
    --g3: var(--pink);
    position: sticky;
    top: calc(90px + var(--i) * 16px);
    min-height: min(78svh, 680px);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 60px);
    align-items: center;
    padding: clamp(24px, 4vw, 64px);
    border-radius: var(--radius);
    background: var(--c-bg);
    color: var(--c-fg);
    box-shadow: 0 -18px 40px -24px rgba(12, 12, 14, 0.4);
    overflow: hidden;
  }
  .card--blue {
    --c-bg: var(--blue);
    --c-fg: var(--paper);
    --g1: var(--paper);
    --g2: var(--blue-deep);
    --g3: var(--pink);
  }
  .card--pink {
    --c-bg: var(--pink);
    --c-fg: var(--ink);
    --g1: var(--ink);
    --g2: #ffb3d8;
    --g3: var(--paper);
  }
  .card--paper {
    --c-bg: var(--paper-2);
    --c-fg: var(--ink);
    --g1: var(--blue);
    --g2: var(--paper);
    --g3: var(--mauve);
  }
  .card--mauve {
    --c-bg: var(--mauve);
    --c-fg: var(--ink);
    --g1: var(--paper);
    --g2: #a58fcb;
    --g3: var(--pink);
  }
  .card--ink {
    --c-bg: var(--ink);
    --c-fg: var(--paper);
    --g1: var(--pink);
    --g2: var(--ink-2);
    --g3: var(--blue);
  }
  .card__text {
    display: grid;
    align-content: space-between;
    gap: 20px;
    height: 100%;
  }
  .card__num {
    opacity: 0.7;
  }
  .card__name {
    font-size: clamp(44px, 6.6vw, 124px);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.055em;
  }
  .card__blurb {
    max-width: 34ch;
    font-size: clamp(17px, 1.4vw, 22px);
    line-height: 1.4;
  }
  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .card__tags li {
    padding: 8px 14px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px currentColor;
    font-size: 11px;
  }
  .card__art {
    width: min(100%, 520px);
    justify-self: center;
    transition: transform 0.8s var(--spring);
  }
  .card:hover .card__art {
    transform: rotate(-4deg) scale(1.04);
  }

  @media (max-width: 800px) {
    .services__head {
      grid-template-columns: 1fr;
    }
    .card {
      grid-template-columns: 1fr;
      min-height: auto;
      top: calc(76px + var(--i) * 10px);
    }
    .card__art {
      order: -1;
      width: min(60%, 260px);
    }
  }
</style>
