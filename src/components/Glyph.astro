---
// Playful service illustrations. Each is built from a few layers that
// drift at different parallax speeds, so the card feels like it has depth.
interface Props {
  name: 'spark' | 'lens' | 'cursor' | 'bubble' | 'arrow';
}
const { name } = Astro.props;
---

<div class={`glyph glyph--${name}`} aria-hidden="true">
  {name === 'spark' && (
    <>
      <span class="g-blob" data-speed="0.08" />
      <svg class="g-main" data-speed="-0.12" viewBox="0 0 100 100">
        <path d="M50 4c4 30 16 42 46 46-30 4-42 16-46 46-4-30-16-42-46-46 30-4 42-16 46-46z" />
      </svg>
      <svg class="g-small" data-speed="-0.25" viewBox="0 0 100 100">
        <path d="M50 4c4 30 16 42 46 46-30 4-42 16-46 46-4-30-16-42-46-46 30-4 42-16 46-46z" />
      </svg>
    </>
  )}
  {name === 'lens' && (
    <>
      <span class="g-blob" data-speed="0.08" />
      <svg class="g-main" data-speed="-0.12" viewBox="0 0 100 100">
        <circle cx="42" cy="42" r="26" fill="none" stroke-width="12" />
        <path d="M62 62l26 26" stroke-width="14" stroke-linecap="round" />
      </svg>
      <span class="g-chip" data-speed="-0.25">
        #1
      </span>
    </>
  )}
  {name === 'cursor' && (
    <>
      <span class="g-window" data-speed="0.06">
        <i />
        <i />
        <i />
      </span>
      <svg class="g-main" data-speed="-0.2" viewBox="0 0 100 100">
        <path d="M20 10l60 30-26 8-8 26z" stroke-width="6" stroke-linejoin="round" />
      </svg>
    </>
  )}
  {name === 'bubble' && (
    <>
      <span class="g-blob" data-speed="0.08" />
      <svg class="g-main" data-speed="-0.12" viewBox="0 0 100 100">
        <path d="M14 20h72a8 8 0 0 1 8 8v36a8 8 0 0 1-8 8H44L24 90V72H14a8 8 0 0 1-8-8V28a8 8 0 0 1 8-8z" />
      </svg>
      <span class="g-heart" data-speed="-0.28">
        &hearts;
      </span>
    </>
  )}
  {name === 'arrow' && (
    <>
      <svg class="g-bars" data-speed="0.06" viewBox="0 0 100 100">
        <rect x="8" y="62" width="18" height="30" rx="4" />
        <rect x="34" y="44" width="18" height="48" rx="4" />
        <rect x="60" y="24" width="18" height="68" rx="4" />
      </svg>
      <svg class="g-main" data-speed="-0.2" viewBox="0 0 100 100">
        <path
          d="M14 76L44 46l14 14 30-32M66 26h22v22"
          fill="none"
          stroke-width="9"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </>
  )}
</div>

<style>
  .glyph {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }
  .glyph > * {
    position: absolute;
  }
  .g-blob {
    inset: 8%;
    border-radius: 42% 58% 55% 45% / 48% 40% 60% 52%;
    background: var(--g2);
    animation: morph 12s ease-in-out infinite alternate;
  }
  .g-main {
    inset: 18%;
    fill: var(--g1);
    stroke: var(--g1);
    filter: drop-shadow(0 18px 24px rgba(12, 12, 14, 0.25));
  }
  .g-small {
    width: 24%;
    top: 4%;
    right: 6%;
    fill: var(--g3);
  }
  .g-chip {
    right: 4%;
    top: 10%;
    padding: 0.3em 0.6em;
    border-radius: 999px;
    background: var(--g3);
    color: var(--ink);
    font-weight: 700;
    font-size: clamp(18px, 2.2vw, 34px);
    letter-spacing: -0.04em;
  }
  .g-window {
    inset: 14% 10% 22%;
    border-radius: 18px;
    background: var(--g2);
    box-shadow: inset 0 28px 0 var(--g3);
  }
  .g-window i {
    position: absolute;
    top: 10px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ink);
  }
  .g-window i:nth-child(1) {
    left: 14px;
  }
  .g-window i:nth-child(2) {
    left: 30px;
  }
  .g-window i:nth-child(3) {
    left: 46px;
  }
  .glyph--cursor .g-main {
    inset: 38% 6% 0 40%;
  }
  .g-heart {
    left: 4%;
    bottom: 6%;
    font-size: clamp(36px, 5vw, 80px);
    line-height: 1;
    color: var(--g3);
    filter: drop-shadow(0 10px 14px rgba(12, 12, 14, 0.25));
  }
  .g-bars {
    inset: 10%;
    fill: var(--g2);
  }
  .glyph--arrow .g-main {
    fill: none;
  }
  @keyframes morph {
    to {
      border-radius: 58% 42% 40% 60% / 60% 52% 48% 40%;
    }
  }
</style>
