---
import { work } from '../data/site';
---

<section class="work wrap" id="work" aria-labelledby="work-title">
  <header class="work__head">
    <p class="eyebrow" data-reveal>
      Selected work
    </p>
    <h2 class="title" id="work-title" data-reveal>
      Results, not <span class="mark">noise.</span>
    </h2>
  </header>
  <ol class="work__list">
    {work.map((w, i) => (
      <li class={`row row--${w.tone}`} data-reveal style={`--d:${i % 3}`}>
        <span class="row__num mono">0{i + 1}</span>
        <h3 class="row__name">{w.name}</h3>
        <p class="row__desc">{w.desc}</p>
        <span class="row__tag mono">{w.tag}</span>
      </li>
    ))}
  </ol>
</section>

<style>
  .work {
    padding-block: clamp(80px, 10vw, 160px);
    background: var(--white);
  }
  .work__head {
    display: grid;
    gap: 20px;
    margin-bottom: clamp(32px, 5vw, 72px);
  }
  .work__list {
    border-top: 1px solid var(--line);
  }
  .row {
    --tone: var(--yellow);
    position: relative;
    display: grid;
    grid-template-columns: 60px minmax(0, 1.2fr) minmax(0, 1fr) auto;
    align-items: center;
    gap: 20px;
    padding: clamp(20px, 2.4vw, 36px) clamp(8px, 1vw, 20px);
    border-bottom: 1px solid var(--line);
    isolation: isolate;
  }
  .row--pink {
    --tone: var(--ink);
  }
  .row--mauve {
    --tone: var(--yellow);
  }
  .row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 18px;
    background: var(--tone);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.55s var(--ease);
  }
  .row:hover::before {
    transform: none;
  }
  .row--pink:hover {
    color: var(--white);
  }
  .row__name {
    font-size: clamp(32px, 4.6vw, 80px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    transition: transform 0.55s var(--spring);
  }
  .row:hover .row__name {
    transform: translateX(14px);
  }
  .row__desc {
    font-size: clamp(16px, 1.2vw, 19px);
  }
  .row__tag {
    padding: 8px 14px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px currentColor;
    font-size: 11px;
  }
  @media (max-width: 760px) {
    .row {
      grid-template-columns: 1fr auto;
      gap: 8px 16px;
    }
    .row__num {
      display: none;
    }
    .row__desc {
      grid-column: 1;
      color: var(--muted);
    }
    .row__tag {
      grid-row: 1;
      grid-column: 2;
    }
  }
</style>
