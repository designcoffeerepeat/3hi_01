---
import Glyph from './Glyph.astro';
import { services } from '../data/site';
---

<section class="services" id="services" aria-labelledby="services-title" data-gallery>
  <div class="services__pin">
    <header class="services__head wrap">
      <p class="eyebrow">Services</p>
      <h2 class="title" id="services-title">
        Five ways <span class="mark">up.</span>
      </h2>
      <p class="services__intro">
        One team connecting AI, design, search, social and growth, so every channel pushes in the
        same direction.
      </p>
    </header>

    <ol class="track" data-track>
      {services.map((s, i) => (
        <li class={`card card--${s.tone}`} style={`--i:${i}`} data-card>
          <div class="card__text">
            <span class="card__num mono">({s.num})</span>
            <h3 class="card__name">{s.name}</h3>
            <p class="card__blurb">{s.blurb}</p>
            <ul class="card__tags mono">
              {s.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </div>
          <div class="card__art">
            <Glyph name={s.glyph as any} />
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .services {
    position: relative;
    background: var(--white);
  }
  .services__pin {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: clamp(20px, 3vw, 40px);
    padding-block: clamp(90px, 10vh, 120px) clamp(24px, 4vh, 48px);
    overflow: hidden;
  }
  .services__head {
    display: grid;
    grid-template-columns: 1fr minmax(0, 32ch);
    align-items: end;
    gap: 12px 40px;
  }
  .services__head .eyebrow {
    grid-column: 1 / -1;
  }
  .services__intro {
    font-size: clamp(17px, 1.3vw, 20px);
    line-height: 1.45;
    color: var(--muted);
  }

  .track {
    display: flex;
    gap: clamp(16px, 2vw, 28px);
    padding-inline: var(--gutter);
    will-change: transform;
  }
  .card {
    --g1: var(--ink);
    --g2: var(--white);
    --g3: var(--yellow);
    flex: 0 0 min(76vw, 1040px);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 60px);
    align-items: center;
    padding: clamp(24px, 3.4vw, 56px);
    border-radius: var(--radius);
    background: var(--c-bg);
    color: var(--c-fg);
    overflow: hidden;
    transform: rotate(var(--tilt, 0deg));
    transition: transform 0.2s linear;
  }
  .card--yellow {
    --c-bg: var(--yellow);
    --c-fg: var(--ink);
    --g1: var(--ink);
    --g2: var(--yellow-soft);
    --g3: var(--white);
  }
  .card--ink {
    --c-bg: var(--ink);
    --c-fg: var(--white);
    --g1: var(--yellow);
    --g2: var(--ink-2);
    --g3: var(--white);
  }
  .card--white {
    --c-bg: var(--paper);
    --c-fg: var(--ink);
    --g1: var(--ink);
    --g2: var(--white);
    --g3: var(--yellow);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .card__text {
    display: grid;
    align-content: space-between;
    gap: 20px;
    height: 100%;
  }
  .card__num {
    opacity: 0.7;
  }
  .card__name {
    font-size: clamp(42px, 5.6vw, 108px);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.045em;
  }
  .card__blurb {
    max-width: 34ch;
    font-size: clamp(17px, 1.35vw, 21px);
    line-height: 1.4;
  }
  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .card__tags li {
    padding: 8px 14px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px currentColor;
    font-size: 11px;
  }
  .card__art {
    width: min(100%, 440px);
    justify-self: center;
    transition: transform 0.8s var(--spring);
  }
  .card:hover .card__art {
    transform: rotate(-6deg) scale(1.06);
  }

  /* Phones and reduced motion: a plain vertical stack, no pinning. */
  @media (max-width: 800px), (prefers-reduced-motion: reduce) {
    .services {
      height: auto !important;
    }
    .services__pin {
      position: static;
      height: auto;
      overflow: visible;
      padding-block: clamp(72px, 10vw, 120px);
    }
    .track {
      flex-direction: column;
      transform: none !important;
    }
    .card {
      flex: none;
      transform: none;
    }
  }
  @media (max-width: 800px) {
    .services__head {
      grid-template-columns: 1fr;
    }
    .card {
      grid-template-columns: 1fr;
    }
    .card__art {
      order: -1;
      width: min(60%, 240px);
    }
  }
</style>

<script>
  // Pin the section and slide the cards sideways as the page scrolls.
  const section = document.querySelector<HTMLElement>('[data-gallery]')!;
  const track = section.querySelector<HTMLElement>('[data-track]')!;
  const cards = [...track.querySelectorAll<HTMLElement>('[data-card]')];
  const flat = matchMedia('(max-width: 800px), (prefers-reduced-motion: reduce)');
  let dist = 0;

  function measure() {
    if (flat.matches) {
      section.style.height = '';
      return;
    }
    dist = Math.max(0, track.scrollWidth - innerWidth);
    section.style.height = `${dist + innerHeight}px`;
  }

  function update() {
    if (!flat.matches) {
      const progress = Math.min(Math.max(-section.getBoundingClientRect().top / (dist || 1), 0), 1);
      track.style.transform = `translate3d(${-progress * dist}px, 0, 0)`;
      // Cards lean a little until they reach the middle of the screen.
      for (const card of cards) {
        const r = card.getBoundingClientRect();
        const off = (r.left + r.width / 2 - innerWidth / 2) / innerWidth;
        card.style.setProperty('--tilt', `${(off * 5).toFixed(2)}deg`);
      }
    }
    requestAnimationFrame(update);
  }

  measure();
  addEventListener('resize', measure);
  flat.addEventListener('change', measure);
  requestAnimationFrame(update);
</script>
